+    # ------------------------------------------------------------------------
+    # PipeSpec (vllm/v1/cmp_pipespec.py). Epoch = chunk A at step e and
+    # chunk B at step e+1 for one request; B was issued by the first rank before
+    # A was verified. Only the last rank knows whether B is valid; message
+    # shapes depend on the step markers alone, so all ranks stay in lockstep.
+    # ------------------------------------------------------------------------
+    def _ps_pre_execute(self, scheduler_output: SchedulerOutput) -> bool:
+        """Set this step's marker. Last rank: returns True to skip the forward
+        of a dropped chunk B."""
+        marks = _cmp_ps.markers(scheduler_output)
+        mark, req_id = "N", None
+        if marks:
+            assert len(marks) == 1 and len(scheduler_output.num_scheduled_tokens) == 1, (
+                marks
+            )
+            ((req_id, mark),) = marks.items()
+        self._ps_mark = mark
+        if not self.is_last_pp_rank:
+            if _BS_RXLATE and mark != "B" and self.pp_handler is not None:
+                # recipe (bs): a deferred chunk-A receive waits only for its chunk B.
+                self.pp_handler.bs_flush_deferred()
+            return False
+        k = self.num_speculative_steps
+        req_idx = self.req_states.req_id_to_index[req_id] if req_id else -1
+        if self._ps_expect_b and mark != "B":
+            # Chunk A without chunk B (abort/pause race). The earlier ranks still
+            # hold the drafts chunk A verified, so this rank must use them too.
+            self._ps_restore_a_drafts()
+        if mark == "A":
+            self._ps_a_req = req_idx
+            self._ps_a_drafts = self.req_states.draft_tokens[req_idx, :k].clone()
+            if self._ps_p2_req != req_idx:
+                self._ps_p2 = None
+            return False
+        if mark == "B":
+            assert self._ps_expect_b and req_idx == self._ps_a_req, (
+                self._ps_expect_b,
+                req_idx,
+                self._ps_a_req,
+            )
+            if not self._ps_b_valid:
+                self._ps_skip = [req_id]
+                return True
+            return False
+        # Normal step: P2 drafts only feed an immediately following epoch.
+        if self._ps_p2 is not None:
+            for rid in scheduler_output.num_scheduled_tokens:
+                if self.req_states.req_id_to_index.get(rid) == self._ps_p2_req:
+                    self._ps_p2 = None
+                    self._ps_p2_req = -1
+                    break
+        return False
+
+    def _ps_restore_a_drafts(self) -> None:
+        if self._ps_a_req >= 0 and self._ps_a_drafts is not None:
+            k = self.num_speculative_steps
+            self.req_states.draft_tokens[self._ps_a_req, :k] = self._ps_a_drafts
+            dl = getattr(self.speculator, "draft_logits", None)
+            if dl is not None:
+                # recipe (probabilistic drafts): the restored tokens were drawn
+                # for other positions, so they are not samples of any cached
+                # q here. Give them one-hot draft logits (q(d) = 1): the
+                # rejection sampler then accepts with p(d) and resamples from
+                # p without d, which is exact for a fixed draft. -1e4 is
+                # finite in bf16 and exp(-1e4 / T) underflows to 0 in fp32.
+                row = dl[self._ps_a_req, :k]
+                row.fill_(-1e4)
+                row.scatter_(1, self._ps_a_drafts.view(k, 1), 0.0)
+        self._ps_expect_b = False
+        self._ps_b_valid = False
+        self._ps_pending = None
+        self._ps_p2 = None
+        self._ps_p2_req = -1
+
+    def _ps_forget(self, req_idx: int) -> None:
+        if req_idx in (self._ps_a_req, self._ps_p2_req):
+            self._ps_expect_b = False
+            self._ps_b_valid = False
+            self._ps_a_req = -1
+            self._ps_a_drafts = None
+            self._ps_b_drafts = None
+            self._ps_pending = None
+            self._ps_p2 = None
+            self._ps_p2_req = -1
+
+    def _ps_set_chunk_b_inputs(self, input_batch: InputBatch) -> None:
+        """First rank: chunk B's input ids are the previous epoch's P2 drafts.
+        Without them (first epoch) the inputs are stale and the last rank drops
+        the chunk, because it has no P2 either."""
+        assert self.pp_handler is not None and input_batch.num_reqs == 1
+        p2 = self.pp_handler.take_p2_for_chunk_b(int(input_batch.idx_mapping_np[0]))
+        if p2 is None:
+            return
+        n = self.num_speculative_steps + 1
+        start = int(input_batch.query_start_loc_np[0])
+        input_batch.input_ids[start : start + n].copy_(p2[:n])
+
+    def _ps_decide_chunk_a(
+        self,
+        input_batch: InputBatch,
+        sampler_output: SamplerOutput,
+        num_rejected: torch.Tensor,
+    ) -> bool:
+        """Last rank, after verifying chunk A: chunk B is valid iff A accepted
+        all k drafts and A's bonus token equals B's first input (P2[0]).
+        One host sync; identical on all TP ranks (same sampled tokens)."""
+        k = self.num_speculative_steps
+        req_idx = int(input_batch.idx_mapping_np[0])
+        self._ps_expect_b = True
+        self._ps_b_valid = False
+        self._ps_b_drafts = None
+        self._ps_pending = None
+        p2 = self._ps_p2 if self._ps_p2_req == req_idx else None
+        self._ps_p2 = None
+        self._ps_p2_req = -1
+        if p2 is None or input_batch.num_reqs != 1:
+            return False
+        if self._ps_flag_host is None:
+            self._ps_flag_host = torch.zeros(1, dtype=torch.int32, pin_memory=True)
+            self._ps_flag_event = torch.cuda.Event()
+        assert self._ps_flag_event is not None
+        ok = (num_rejected[:1] == 0) & (
+            sampler_output.sampled_token_ids[:1, k] == p2[:1, 0]
+        )
+        self._ps_flag_host.copy_(ok.to(torch.int32), non_blocking=True)
+        self._ps_flag_event.record(self.main_stream)
+        self._ps_flag_event.synchronize()
+        valid = bool(self._ps_flag_host[0].item())
+        self._ps_b_valid = valid
+        if valid:
+            self._ps_b_drafts = p2[0, 1 : k + 1]
+        return valid
+
+    def _ps_arm_chunk_b(self, input_batch: InputBatch) -> None:
+        """Last rank: chunk B verifies P2[1:]; its first input is A's bonus,
+        already in last_sampled_tokens."""
+        assert self._ps_b_drafts is not None
+        k = self.num_speculative_steps
+        req_idx = int(input_batch.idx_mapping_np[0])
+        self.req_states.draft_tokens[req_idx, :k] = self._ps_b_drafts
+        dl = getattr(self.speculator, "draft_logits", None)
+        if dl is not None:
+            # recipe (probabilistic drafts): chunk B verifies d4,d5 = chain steps
+            # k+1..2k, whose pre-temperature logits sit in cache columns
+            # k+1..2k (continue_chain wrote them with current_draft_step =
+            # chain step). The rejection sampler indexes column i for chunk
+            # position i, so move them to columns 0..k-1 (A's columns are no
+            # longer needed: A was verified in this same sample_tokens call).
+            dl[req_idx, :k].copy_(dl[req_idx, k + 1 : 2 * k + 1])
+
+    def _ps_finish_epoch(
+        self,
+        input_batch: InputBatch,
+        draft_tokens: torch.Tensor | None,
+        send_now: bool,
+    ) -> None:
+        """Last rank: the epoch ended at this chunk. P1 = the k drafts just
+        proposed (next chunk A), P2 = the same chain continued by k+1 (next
+        chunk B). Sent now after a valid B; after a failed A they ride on the
+        dropped chunk B's message (sample_tokens of step e+1)."""
+        assert self.pp_handler is not None and draft_tokens is not None
+        k = self.num_speculative_steps
+        num_reqs = input_batch.num_reqs
+        p1 = draft_tokens[:num_reqs, :k].clone()
+        ev1 = torch.cuda.Event()
+        ev1.record(self.main_stream)
+        if send_now:
+            self.pp_handler.broadcast_rows(p1, ev1)
+        spec = self.speculator
+        p2_ok = getattr(spec, "num_p2", 0) == k + 1 and spec._chain_ctx is not None
+        if _BS_P1EARLY and not send_now and p2_ok and num_reqs == 1:
+            # recipe (bs): failed chunk A. Park P1 only; the P2 chain is continued
+            # in step B's execute_model (_bs_send_dropped), behind the
+            # dropped-chunk message and P1, so the host reaches that send
+            # before P1 is ready on the GPU.
+            self._ps_pending = (p1, ev1, None, None)
+            self._bs_defer_req = int(input_batch.idx_mapping_np[0])
+            self._ps_p2 = None
+            self._ps_p2_req = -1
+            return
+        if p2_ok:
+            with use_workspace_lane(self._draft_workspace_lane):
+                p2 = spec.continue_chain()[:num_reqs].clone()
+        else:
+            p2 = torch.zeros(num_reqs, k + 1, dtype=torch.int64, device=self.device)
+        ev2 = torch.cuda.Event()
+        ev2.record(self.main_stream)
+        if send_now:
+            self.pp_handler.broadcast_rows(p2, ev2)
+            self._ps_expect_b = False
+        else:
+            self._ps_pending = (p1, ev1, p2, ev2)
+        self._ps_p2 = p2 if (p2_ok and num_reqs == 1) else None
+        self._ps_p2_req = int(input_batch.idx_mapping_np[0])
+
+    def _ps_dropped_chunk_output(self) -> ModelRunnerOutput:
+        """Last rank, dropped chunk B: send its message (no tokens, k+1
+        rejected, then the epoch's P1/P2) and report no tokens."""
+        assert self.pp_handler is not None and self._ps_skip is not None
+        req_ids = self._ps_skip
+        self._ps_skip = None
+        pending = self._ps_pending
+        self._ps_pending = None
+        self._ps_expect_b = False
+        if self._bs_sent:
+            # recipe (bs): already sent from execute_model (_bs_send_dropped).
+            self._bs_sent = False
+            return ModelRunnerOutput(
+                req_ids=req_ids,
+                req_id_to_index={rid: i for i, rid in enumerate(req_ids)},
+                sampled_token_ids=[[] for _ in req_ids],
+            )
+        assert pending is not None, "PipeSpec: dropped chunk B without epoch drafts"
+        p1, ev1, p2, ev2 = pending
+        self.pp_handler.broadcast_dropped_chunk(len(req_ids))
+        self.pp_handler.broadcast_rows(p1, ev1)
+        self.pp_handler.broadcast_rows(p2, ev2)
+        return ModelRunnerOutput(
+            req_ids=req_ids,
+            req_id_to_index={rid: i for i, rid in enumerate(req_ids)},
+            sampled_token_ids=[[] for _ in req_ids],
+        )
+
+    def _bs_send_dropped(self) -> None:
+        """recipe (bs, CMP_BS_P1EARLY=1): last rank, dropped chunk B, called from
+        execute_model right after the drop decision. Sends what
+        `_ps_dropped_chunk_output` would send one RPC later (same messages,
+        same order) and runs the P2 draft chain that `_ps_finish_epoch` left
+        out in step A."""
+        assert self.pp_handler is not None and self._ps_skip is not None
+        pending = self._ps_pending
+        self._ps_pending = None
+        assert pending is not None, "PipeSpec: dropped chunk B without epoch drafts"
+        p1, ev1, p2, ev2 = pending
+        num_reqs = len(self._ps_skip)
+        self.pp_handler.broadcast_dropped_chunk(num_reqs)
+        self.pp_handler.broadcast_rows(p1, ev1)
+        if p2 is None:
+            k = self.num_speculative_steps
+            spec = self.speculator
+            p2_ok = getattr(spec, "num_p2", 0) == k + 1 and spec._chain_ctx is not None
+            if p2_ok:
+                with use_workspace_lane(self._draft_workspace_lane):
+                    p2 = spec.continue_chain()[:num_reqs].clone()
+            else:
+                p2 = torch.zeros(num_reqs, k + 1, dtype=torch.int64, device=self.device)
+            ev2 = torch.cuda.Event()
+            ev2.record(self.main_stream)
+            self._ps_p2 = p2 if (p2_ok and num_reqs == 1) else None
+            self._ps_p2_req = self._bs_defer_req
+        self.pp_handler.broadcast_rows(p2, ev2)
+        self._bs_sent = True
+
     def take_draft_token_ids(self) -> DraftTokenIds | None:
         return self.draft_tokens_handler.get_draft_tokens()
 
