+    # recipe (jor) ---------------------------------------------------------------
+    @staticmethod
+    def _jo_stop_ids(
+        request: "Request", reasoner: "ReasoningParser | None" = None
+    ) -> tuple[int, ...]:
+        """The tokens check_stop ends this request on: the primary EOS (None
+        under ignore_eos) and stop_token_ids (which hold the other
+        generation-config EOS ids). A reasoning-end marker the client also
+        gave as a stop token stays allowed: it is the way out of reasoning."""
+        params = request.sampling_params
+        if params is None:
+            return ()
+        ids = set(params.stop_token_ids or ())
+        if params.eos_token_id is not None:
+            ids.add(params.eos_token_id)
+        if reasoner is not None:
+            ids -= set(getattr(reasoner, "reasoning_end_token_ids", None) or ())
+        return tuple(sorted(i for i in ids if i >= 0))
+
+    def _jo_stop_words(
+        self, request: "Request", reasoner: "ReasoningParser | None" = None
+    ) -> tuple[tuple[int, int], ...]:
+        """(word index, int32 and-mask) pairs that clear the request's stop
+        tokens from a bitmask row."""
+        stop_ids = self._jo_stop_ids(request, reasoner)
+        cache = self._jo_cache
+        words = cache.get(stop_ids)
+        if words is None:
+            merged: dict[int, int] = {}
+            for token_id in stop_ids:
+                word = token_id // 32
+                merged[word] = merged.get(word, 0xFFFFFFFF) & ~(1 << (token_id % 32))
+            words = tuple(
+                (word, mask - (1 << 32) if mask >= (1 << 31) else mask)
+                for word, mask in sorted(merged.items())
+            )
+            if len(cache) < 4096:
+                cache[stop_ids] = words
+        return words
+
+    def _jo_forbid_stop(self, index: int, words: tuple[tuple[int, int], ...]) -> None:
+        assert self._grammar_bitmask is not None
+        row = self._grammar_bitmask[index]
+        num_words = row.shape[0]
+        for word, mask in words:
+            if word < num_words:
+                row[word] &= mask
+
+    def _jo_count(self, steps: int, rows: int, draft_stops: int, ended: int) -> None:
+        stats = self._jo_stats
+        before = stats[0]
+        stats[0] += steps
+        stats[1] += rows
+        stats[2] += draft_stops
+        stats[3] += ended
+        if _JO_LOG and (ended or (steps and before // _JO_LOG != stats[0] // _JO_LOG)):
+            logger.info(
+                "CMP jo: nostop %s: %d reasoning steps of structured requests, "
+                "%d rows without stop tokens, %d drafted stop tokens inside "
+                "reasoning, %d requests ended inside reasoning",
+                "on" if _JO_NOSTOP else "off",
+                *stats,
+            )
+
+    def _jo_note_stop_in_reasoning(
+        self, request: "Request", new_token_ids: list[int]
+    ) -> None:
+        """Called when a step left the request inside reasoning: a stop token
+        as its last token means the turn ended there (content stays empty)."""
+        if new_token_ids[-1] not in self._jo_stop_ids(request):
+            return
+        if _JO_NOSTOP:
+            logger.error(
+                "CMP jo: UNEXPECTED: request %s ended on stop token %d inside "
+                "reasoning with nostop on.",
+                request.request_id,
+                new_token_ids[-1],
+            )
+        self._jo_count(0, 0, 0, 1)
+
