         self._pipespec = _cmp_ps.SchedulerPipeSpec(self)
+        # recipe (g5): [structured draft windows, windows left with placeholders].
+        self._g5_stats = [0, 0]
         self.num_lookahead_tokens = self._pipespec.lookahead(self.num_lookahead_tokens)
         # DP prefill balancing: Flag to track whether the last cadence-aligned
