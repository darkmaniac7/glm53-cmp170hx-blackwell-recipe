 logger = init_logger(__name__)
 
+# recipe (g5): structured-output drafts (get_grammar_bitmask). NET keeps the g4
+# invalidation for windows that still hold placeholders; LOG prints the
+# counters every N structured draft windows (0 = never).
+_G5_NET = os.environ.get("CMP_G5_NET", "1") != "0"
+_G5_LOG = int(os.environ.get("CMP_G5_LOG", "2000") or 0)
+
 
 class Scheduler(SchedulerInterface):
     def __init__(
@@ -332,6 +338,8 @@
         # PipeSpec (inert unless CMP_PIPESPEC=1): two-chunk speculative
