# pp5bw30: TP2 x PP5 across two hosts, 524,288-token context.
#   node 0  two RTX PRO 6000 Blackwell, stage 0: layers 0-29 and the embedding (leader, serves the API)
#   node 1-4  four pairs of CMP 170HX, 12 layers each; the last pair also holds the norm, lm_head and the MTP layer
# KV pool 817,024 tokens. Measured numbers and conditions: ../../docs/outcomes.md
TAG=pp5bw30
TP=2
PP=5
NNODES=5
PART=30,12,12,12,12
MAX_LEN=524288
MAX_SEQS=8
MAX_BATCHED=2048
# MTP k=2 with probabilistic drafts under PipeSpec (overlay sq). For greedy drafts drop draft_sample_method.
SPEC_JSON='{"method":"mtp","num_speculative_tokens":2,"draft_sample_method":"probabilistic"}'
CMP_PIPESPEC=1
# Needed on every node of a mixed sm_120 / sm_80 engine: without it the sm_120 ranks enter the flashinfer autotune
# broadcast while the sm_80 ranks wait in the pipeline warm-up, and the load hangs.
EXTRA_ARGS=--no-enable-flashinfer-autotune
# GPUs per node: indices on the node's own host (CUDA_DEVICE_ORDER=PCI_BUS_ID) or GPU UUIDs, comma separated.
NODE_0=0,1
NODE_1=0,1
NODE_2=2,3
NODE_3=4,5
NODE_4=6,7
