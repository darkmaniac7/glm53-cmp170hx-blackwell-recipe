# l62b: TP2 x PP4, the two Blackwells and SIX CMP 170HX; two CMPs stay free. 524,288-token context.
#   node 0  two RTX PRO 6000 Blackwell, stage 0: layers 0-29 and the embedding (leader, serves the API)
#   node 1-3  three pairs of CMP 170HX with 17, 17 and 14 layers; the last pair also holds the norm, lm_head and MTP layer
# Giving the last stage 14 layers keeps the KV pool at 817,024 tokens (30,16,16,16 drops it to 606,464).
# Decode speed equals pp5bw30; prefill is 21 to 23% slower because the largest CMP stage sets the prefill rate.
TAG=l62b
TP=2
PP=4
NNODES=4
PART=30,17,17,14
MAX_LEN=524288
MAX_SEQS=8
MAX_BATCHED=2048
SPEC_JSON='{"method":"mtp","num_speculative_tokens":2,"draft_sample_method":"probabilistic"}'
CMP_PIPESPEC=1
EXTRA_ARGS=--no-enable-flashinfer-autotune
NODE_0=0,1
NODE_1=0,1
NODE_2=2,3
NODE_3=4,5
