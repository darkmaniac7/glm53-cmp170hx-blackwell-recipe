# host.env: one copy per host, next to node.sh. Everything that differs between the Blackwell host and the CMP host.

# Address of node 0 (the leader) on the fast link between the hosts, the same value on both hosts.
# (192.0.2.x below are placeholders.)
MASTER_ADDR=192.0.2.1
MASTER_PORT=29531
# This host's own address and interface on that link.
HOST_ADDR=192.0.2.1
HOST_IFNAME=enp1s0np0

# Engine image: the sm_120 build on the Blackwell host, the base image on the CMP host (README.md, "The sm_120 image").
HOST_IMAGE=glm53-multinode:sm120

# A checkout of cebeuq's recipe with this repository's overlays copied in (tools/apply-overlays.sh).
HOST_RECIPE_DIR=/srv/glm53/glm53-cmp170hx-recipe
# A LOCAL copy of the hybrid checkpoint on this host, sha256-verified. Not NFS.
# For layouts/pp5bw30-s0r4bs.env: the stage-0 4-bit checkpoint (tools/stage0-4bit), on both hosts.
HOST_MODEL_DIR=/srv/glm53/models/glm53-abliterated-nvfp4e-int8r
# Where node.sh puts the per-node views, the JIT caches and the logs.
HOST_VIEW_DIR=/srv/glm53/view
HOST_CACHE_DIR=/srv/glm53/cache
HOST_LOG_DIR=/srv/glm53/logs

# gpu-memory-utilization and the container memory limit. Measured values: 0.95 and 200g for the Blackwell node,
# 0.97 and 120g for each CMP node. The limit counts page cache: too small and the loader evicts and re-reads shards.
HOST_UTIL=0.95
HOST_MEM=200g

# Blackwell host only: multithreaded loading of the 170 GB stage (load-time only).
HOST_LOADER_JSON='{"enable_multithread_load":true,"num_threads":8}'
# CMP host: leave HOST_LOADER_JSON empty, and cap reads from the NVMe that holds the weights:
# HOST_READ_BPS_DEVICE=/dev/nvme0n1
# HOST_READ_BPS=450mb

# The API of node 0. It has no authentication: bind it to an address only you can reach.
API_HOST=127.0.0.1
API_PORT=8000
