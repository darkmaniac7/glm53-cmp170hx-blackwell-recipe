# Environment of every node container (docker --env-file). node.sh adds the per-host values:
# VLLM_HOST_IP, NCCL_SOCKET_IFNAME, GLOO_SOCKET_IFNAME, VLLM_PP_LAYER_PARTITION, CMP_PIPESPEC.
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=128
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_LOGGING_LEVEL=INFO
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
HF_HUB_OFFLINE=1
# NCCL: peer-to-peer inside a node, RDMA (IB verbs) across the link between the hosts
NCCL_P2P_DISABLE=0
NCCL_P2P_LEVEL=SYS
NCCL_IB_DISABLE=0
NCCL_IB_HCA=mlx5_0
NCCL_NET_GDR_LEVEL=SYS
NCCL_PROTO=LL,LL128,Simple
VLLM_SKIP_P2P_CHECK=0
# the recipe's switches (cebeuq's patches/README.md)
CMP_PCIE_CUSTOM_AR=1
CMP_INDEXER_PREFILL_BUF_FACTOR=4
CMP_KV_DSMLA_INT8=1
CMP_PIPESPEC_REFILL=0
CMP_PIPESPEC_LOG=200
CMP_FAIR_CHUNK=0
# JIT caches on a host directory, so a reload does not recompile
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
TORCHINDUCTOR_CACHE_DIR=/cache/inductor
FLASHINFER_WORKSPACE_BASE=/cache/flashinfer
TILELANG_CACHE_DIR=/cache/tilelang
CUDA_CACHE_PATH=/cache/nv
CUDA_CACHE_MAXSIZE=4294967296
CUDA_DEVICE_ORDER=PCI_BUS_ID
